				{
					"name": "POST Đăng nhập (Login & Nhận Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Đăng nhập thành công 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"pm.test(\"Nhận được JWT Token hợp lệ\", function () {",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.expect(jsonData.type).to.eql('Bearer');",
									"    pm.expect(jsonData.username).to.eql('binh');",
									"});",
									"",
									"// Tự động lưu Token vào biến để các API khác dùng chung",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
									"    pm.environment.set(\"jwt_token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"binh\",\n    \"password\": \"binh2502\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
